# =============================================================================
# RAGDjango 配置模板
#
# 使用方法：
#   1. 复制本文件为 .env      （cp .env.example .env  /  copy .env.example .env）
#   2. 按下面的说明填入你自己的值
#   3. .env 已被 .gitignore 忽略，不会被提交到仓库
#
# 说明：所有值也可以直接用「系统环境变量」注入（优先级高于 .env），
#       未配置时程序使用代码里的默认值或给出明确报错。
# =============================================================================

# ------------------------------- Django --------------------------------------
# 生产环境务必替换成随机字符串，可用下面的命令生成：
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string

# 开发用 True；正式部署必须改成 False
DJANGO_DEBUG=True

# 允许访问的域名，逗号分隔。本地开发可留空（默认 127.0.0.1,localhost）
DJANGO_ALLOWED_HOSTS=

# ------------------------------ 大模型（对话） --------------------------------
# 兼容 OpenAI 协议的任意网关（阿里云百炼 / DashScope / OpenAI / 本地 vLLM 等）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen-max

# ------------------------------ 文本向量化 ------------------------------------
# 用于「离线建库（ingest.py）」和「在线检索（rag.py）」的 Embedding 模型
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=text-embedding-v3

# -------------------------------- 邮件 --------------------------------------
# QQ 邮箱示例：MAIL_FROM=your_account@qq.com，MAIL_PASSWORD 填「SMTP 授权码」而非登录密码
MAIL_FROM=
MAIL_PASSWORD=

# -------------------------------- MySQL -------------------------------------
# 只用于业务库 rag.users（登录校验 + 邮件助手查收件人）。
# 建表脚本：sql/schema.sql
# 注意：Django 自身的表（admin/session/auth）仍走 SQLite 的 db.sqlite3，
#       由 python manage.py migrate 生成，与这里的 MySQL 无关。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rag

# -------------------------------- Redis -------------------------------------
# 存登录验证码，键格式 login:code:{email}，TTL 300 秒
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
